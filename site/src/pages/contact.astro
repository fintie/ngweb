---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Form from '../components/Form.astro';
---
<Base title="Book a Free Initial Consultation | NextGenius" description="Book a free initial consultation with NextGenius. Discuss your goals, current tools and how AI, automation or custom software could help. No obligation to proceed." noTalk={true}>
<PageHero eyebrow="Contact NextGenius" title="Start with a free consultation." lead="Tell us what’s slowing your business down. In a free initial consultation, we’ll discuss your goals, current tools and whether NextGenius can help. There is no obligation to proceed." unit="u064 u068" />

<section class="wrap" style="padding-bottom:var(--section-y)">
  <div class="split">
    <div data-unit="u065"><p class="eyebrow su">Request your free initial consultation</p><h2 class="up ta" style="margin-bottom:var(--space-block)">How can we help?</h2><div class="sa"><Form question="What would you like to improve?" /></div></div>
    <div>
      <div data-unit="u066" class="su"><p class="eyebrow">What happens next?</p>
        <ul class="ticklist"><li>Send your enquiry and check for the confirmation.</li><li>We reply to arrange your free initial consultation.</li><li>Discuss your priorities, current tools and whether we are a good fit.</li></ul>
        <div class="buying-note"><p>The initial consultation is free. Any detailed assessment, prototype or delivery work is scoped and priced separately before you commit.</p><p>A deadline, budget constraint or example of the current process helps us prepare.</p><p><a class="tlink" href="/getting-started/">How discovery, estimates and delivery work</a></p></div></div>
      <div data-unit="u067" class="su" style="margin-top:var(--space-block);--i:1"><p class="eyebrow">Prefer to email directly?</p>
        <p style="margin-top:var(--space-3);font-size:clamp(20px,2.2vw,34px);letter-spacing:-.02em"><a class="tlink" style="font-size:inherit" href="mailto:info@nextgenius.com.au">info@nextgenius.com.au</a></p>
        <p style="margin-top:var(--space-2)">15 Broadway, Ultimo NSW 2007, Australia</p>
        <p class="small" style="margin-top:var(--space-3)">Please share a general description of the challenge. Confidential documents can be discussed later.</p></div>
    </div>
  </div>
</section>
</Base>
